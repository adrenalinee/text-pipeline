{
  "name": "text-pipeline",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev --port 3000",
    "dev:local": "node ./node_modules/vite/bin/vite.js dev --host 127.0.0.1 --port 3000",
    "dev:server": "node ./scripts/dev-server.mjs start",
    "dev:status": "node ./scripts/dev-server.mjs status",
    "dev:logs": "node ./scripts/dev-server.mjs logs",
    "dev:stop": "node ./scripts/dev-server.mjs stop",
    "generate-routes": "node ./node_modules/@tanstack/router-cli/bin/tsr.cjs generate",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write . && node ./node_modules/eslint/bin/eslint.js --fix",
    "check": "node ./node_modules/prettier/bin/prettier.cjs --check ."
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.0.0",
    "@codemirror/lang-xml": "^6.0.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@mantine/code-highlight": "^9.3.0",
    "@mantine/core": "^9.3.0",
    "@mantine/form": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@mantine/modals": "^9.3.0",
    "@mantine/notifications": "^9.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vercel/analytics": "^2.0.1",
    "cm6-graphql": "^0.2.1",
    "graphql": "^17.0.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.545.0",
    "mantine-datatable": "^9.2.2",
    "node-sql-parser": "^5.4.0",
    "parse5": "8.0.1",
    "prettier": "3.8.3",
    "react": "^19.2.0",
    "react-diff-view": "3.3.3",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.6.1",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
